diff --git a/.github/workflows/plugin-eval.yml b/.github/workflows/plugin-eval.yml
new file mode 100644
--- /dev/null
+++ b/.github/workflows/plugin-eval.yml
@@ -0,0 +1,38 @@
+name: plugin-eval
+# Évaluation du plugin avec le modèle (T06, décision 96) : lancement à la main seulement (coût, secret d'API).
+on:
+  workflow_dispatch:
+    inputs:
+      runs:
+        description: "Passages par cas"
+        default: "1"
+      max_cost_usd:
+        description: "Plafond de coût en dollars"
+        default: "15"
+jobs:
+  eval:
+    runs-on: ubuntu-latest
+    timeout-minutes: 120
+    steps:
+      - uses: actions/checkout@v4
+      - uses: astral-sh/setup-uv@v5
+      - uses: actions/setup-node@v4
+        with:
+          node-version: "22"
+      - run: uv sync
+      - run: npm install -g @anthropic-ai/claude-code
+      - name: Évaluation
+        env:
+          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
+        run: |
+          mkdir -p plugin/evals/results
+          claude plugin eval plugin --trust-plugin --mocks off --allow-tools "mcp__plugin_forever_forever__*" \
+            --runs "${{ inputs.runs }}" --ablation none --max-cost-usd "${{ inputs.max_cost_usd }}" --no-publish \
+            --keep-temp --threshold 0 --json plugin/evals/results/passage.json
+      - name: Rapport (seuils de la tranche)
+        run: uv run python scripts/plugin_eval_report.py plugin/evals/results/passage.json
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: plugin-eval
+          path: plugin/evals/results/
