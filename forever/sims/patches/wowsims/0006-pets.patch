diff --git a/sim/core/forever_pet_stats.go b/sim/core/forever_pet_stats.go
new file mode 100644
index 0000000..2324053
--- /dev/null
+++ b/sim/core/forever_pet_stats.go
@@ -0,0 +1,56 @@
+package core
+
+// forever (SIM2, décision 305) : valeurs de créature (ExpectedStat du client) au niveau du personnage, d'où les
+// familiers tirent leurs PV, leur armure, leur puissance d'attaque et leurs dégâts, lues dans le fichier donné par
+// --forever-pet-stats=<fichier.json> (écrit par forever depuis ses données du client). Sans l'option, les valeurs
+// du niveau 60 (CreatureHealthMaxLevel, etc.) restent, donc le comportement d'origine. Le fichier ne porte que des
+// valeurs ; ce code n'en contient aucune.
+//
+// Clés : creature_health, creature_armor, creature_auto_attack_dps (ligne d'ExpectedStat au niveau du personnage).
+
+import (
+	"encoding/json"
+	"os"
+	"strings"
+)
+
+const ForeverPetStatsFlag = "--forever-pet-stats="
+
+// Valeurs de créature lues par les familiers (Chasseur, faucons, démons) : celles du niveau 60 sans l'option.
+var (
+	ForeverCreatureHealth        float64 = CreatureHealthMaxLevel
+	ForeverCreatureArmor         float64 = CreatureArmorMaxLevel
+	ForeverCreatureAutoAttackDps float64 = CreatureAutoAttackDpsMaxLevel
+)
+
+type foreverPetStats struct {
+	CreatureHealth        *float64 `json:"creature_health"`
+	CreatureArmor         *float64 `json:"creature_armor"`
+	CreatureAutoAttackDps *float64 `json:"creature_auto_attack_dps"`
+}
+
+func init() {
+	path := ""
+	for _, arg := range os.Args[1:] {
+		if value, ok := strings.CutPrefix(arg, ForeverPetStatsFlag); ok {
+			path = value
+		}
+	}
+	if path == "" {
+		return
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		panic("forever: --forever-pet-stats illisible : " + err.Error())
+	}
+	var doc foreverPetStats
+	if err := json.Unmarshal(raw, &doc); err != nil {
+		panic("forever: --forever-pet-stats invalide : " + err.Error())
+	}
+	if doc.CreatureHealth == nil || doc.CreatureArmor == nil || doc.CreatureAutoAttackDps == nil {
+		panic("forever: --forever-pet-stats attend creature_health, creature_armor et creature_auto_attack_dps")
+	}
+	ForeverCreatureHealth = *doc.CreatureHealth
+	ForeverCreatureArmor = *doc.CreatureArmor
+	ForeverCreatureAutoAttackDps = *doc.CreatureAutoAttackDps
+}
