 // Registers a new spell to the unit. Returns the newly created spell.
 func (unit *Unit) RegisterSpell(config SpellConfig) *Spell {
+	// forever (SIM2) : sous le niveau 60, deux rangs d'origine (entraîneur et livre) ramenés au même rang
+	// appris ne l'enregistrent qu'une fois.
+	if CharacterLevel < 60 {
+		for _, existing := range unit.Spellbook {
+			if existing.ActionID == config.ActionID {
+				return existing
+			}
+		}
+	}
 	if len(unit.Spellbook) > 1000 {
 		panic(fmt.Sprintf("Over 1000 registered spells when registering %s! There is probably a spell being registered every iteration.", config.ActionID))
 	}
diff --git a/sim/core/spelldata/ladder.go b/sim/core/spelldata/ladder.go
index c0903b6..34bf646 100644
--- a/sim/core/spelldata/ladder.go
+++ b/sim/core/spelldata/ladder.go
@@ -21,7 +21,67 @@ func Ranked(ids ...int32) Ladder {
 	for i, id := range ids {
 		ranks[i] = MustFind(id)
 	}
-	return Ladder{ranks: ranks}
+	l := Ladder{ranks: ranks}
+	l.foreverAlias()
+	return l
+}
+
+// forever (SIM2) : rang appris au niveau du personnage, le plus haut dont SpellLevel <= niveau ; nil si
+// aucun. Un rang sans SpellLevel (0 : sort déclenché, objet) compte comme appris.
+func (l Ladder) foreverLearned() *Spell {
+	var best *Spell
+	for _, s := range l.ranks {
+		if int32(s.SpellLevel) <= core.CharacterLevel {
+			best = s
+		}
+	}
+	return best
+}
+
+// forever (SIM2) : une échelle de plusieurs entrées toutes du même niveau d'apprentissage réunit des effets
+// frères (Demonic Sacrifice : un effet par démon), pas des rangs : jamais plafonnée.
+func (l Ladder) foreverSiblings() bool {
+	if len(l.ranks) < 2 {
+		return false
+	}
+	for _, s := range l.ranks {
+		if s.SpellLevel != l.ranks[0].SpellLevel {
+			return false
+		}
+	}
+	return true
+}
+
+// forever (SIM2) : chaque rang de l'échelle désigne, pour l'APL, le rang appris (0 : aucun appris).
+func (l Ladder) foreverAlias() {
+	if core.CharacterLevel >= 60 || l.foreverSiblings() {
+		return
+	}
+	// seuls les rangs pas encore appris sont redirigés : un rang appris garde son identifiant (une échelle peut
+	// réunir des effets frères, comme Demonic Sacrifice, qui ne sont pas des rangs)
+	learned := l.foreverLearned()
+	for _, s := range l.ranks {
+		if int32(s.SpellLevel) <= core.CharacterLevel {
+			continue
+		}
+		if learned == nil {
+			core.ForeverRankAlias[s.ID] = 0
+		} else {
+			core.ForeverRankAlias[s.ID] = learned.ID
+		}
+	}
+}
+
+// forever (SIM2) : rang retenu au lieu d'un rang pas encore appris ; le premier rang si aucun ne l'est
+// (le sort reste enregistré, mais l'APL ne le trouve plus : foreverAlias).
+func (l Ladder) foreverCap(s *Spell) *Spell {
+	if int32(s.SpellLevel) <= core.CharacterLevel || l.foreverSiblings() {
+		return s
+	}
+	if learned := l.foreverLearned(); learned != nil {
+		return learned
+	}
+	return l.ranks[0]
 }
 
