+package core
+
+// forever (SIM2, décision 305) : niveau du personnage simulé, donné par l'option --forever-level=N
+// (1 à 60) de la ligne de commande ; 60 par défaut, donc le comportement d'origine.
+//
+// Il est lu à l'initialisation du paquet et non dans la requête : les rangs des sorts sont choisis
+// par des variables de paquet (spelldata.Ladder), évaluées avant main().
+
+import (
+	"os"
+	"strconv"
+	"strings"
+)
+
+const ForeverLevelFlag = "--forever-level="
+
+func foreverLevel() int32 {
+	for _, arg := range os.Args[1:] {
+		if value, ok := strings.CutPrefix(arg, ForeverLevelFlag); ok {
+			level, err := strconv.Atoi(value)
+			if err != nil || level < 1 || level > 60 {
+				panic("forever: --forever-level attend un niveau de 1 à 60, reçu " + value)
+			}
+			return int32(level)
+		}
+	}
+	return 60
+}
+
+// Rang appris au niveau du personnage pour chaque rang d'une échelle de sorts (rempli par
+// spelldata.Ranked) : un identifiant de rang cité par l'APL désigne le rang appris ; 0 si aucun rang
+// de l'échelle n'est appris à ce niveau (l'APL ne trouve alors aucun sort et retire l'action).
+var ForeverRankAlias = map[int32]int32{}
+
+func foreverResolveSpellID(id int32) int32 {
+	if alias, ok := ForeverRankAlias[id]; ok {
+		if alias == 0 {
+			return -1
+		}
+		return alias
+	}
+	return id
+}
