diff --git a/sim/core/forever_base_stats.go b/sim/core/forever_base_stats.go
new file mode 100644
--- /dev/null
+++ b/sim/core/forever_base_stats.go
@@ -0,0 +1,131 @@
+package core
+
+// forever (SIM2, décision 305) : statistiques de base au niveau du personnage, lues dans le fichier donné par
+// --forever-base-stats=<fichier.json> (écrit par forever, valeurs du client et relevés en jeu) ; sans l'option, les
+// tables du niveau 60 restent. Le fichier ne porte que des valeurs ; ce code n'en contient aucune.
+//
+// - mana, crit_per_int, crit_per_agi : mana de base et critique (en pour cent) par point d'Intelligence ou
+//   d'Agilité de la classe au niveau du personnage (tables du client) ;
+// - anchors : relevés en jeu des attributs sans équipement (classe, race, niveau). L'écart de race de wowsims
+//   (RaceOffsets) en est retiré, puis les attributs de la classe sont interpolés linéairement entre les deux relevés
+//   qui encadrent le niveau, le niveau 60 valant les tables de wowsims. Sans relevé au niveau ou en dessous, les
+//   attributs du niveau 60 restent (forever le dit).
+
+import (
+	"encoding/json"
+	"os"
+	"sort"
+	"strings"
+
+	"github.com/wowsims/forever/sim/core/proto"
+	"github.com/wowsims/forever/sim/core/stats"
+)
+
+const ForeverBaseStatsFlag = "--forever-base-stats="
+
+type foreverAnchor struct {
+	Level     int32   `json:"level"`
+	Race      string  `json:"race"`
+	Strength  float64 `json:"strength"`
+	Agility   float64 `json:"agility"`
+	Stamina   float64 `json:"stamina"`
+	Intellect float64 `json:"intellect"`
+	Spirit    float64 `json:"spirit"`
+}
+
+type foreverBaseStats struct {
+	Class      string          `json:"class"`
+	Mana       *float64        `json:"mana"`
+	CritPerInt *float64        `json:"crit_per_int"`
+	CritPerAgi *float64        `json:"crit_per_agi"`
+	Anchors    []foreverAnchor `json:"anchors"`
+}
+
+var foreverAttributes = []stats.Stat{stats.Strength, stats.Agility, stats.Stamina, stats.Intellect, stats.Spirit}
+
+func (a foreverAnchor) values() []float64 {
+	return []float64{a.Strength, a.Agility, a.Stamina, a.Intellect, a.Spirit}
+}
+
+func foreverApplyBaseStats() {
+	path := ""
+	for _, arg := range os.Args[1:] {
+		if value, ok := strings.CutPrefix(arg, ForeverBaseStatsFlag); ok {
+			path = value
+		}
+	}
+	if path == "" {
+		return
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		panic("forever: --forever-base-stats illisible : " + err.Error())
+	}
+	var doc foreverBaseStats
+	if err := json.Unmarshal(raw, &doc); err != nil {
+		panic("forever: --forever-base-stats invalide : " + err.Error())
+	}
+	class := proto.Class(proto.Class_value[doc.Class])
+	if class == proto.Class_ClassUnknown {
+		panic("forever: --forever-base-stats : classe inconnue " + doc.Class)
+	}
+	extra := ExtraClassBaseStats[class]
+	if doc.Mana != nil {
+		extra[stats.Mana] = *doc.Mana
+	}
+	ExtraClassBaseStats[class] = extra
+	if doc.CritPerInt != nil {
+		CritPerIntMaxLevel[class] = *doc.CritPerInt
+	}
+	if doc.CritPerAgi != nil {
+		CritPerAgiMaxLevel[class] = *doc.CritPerAgi
+	}
+	foreverInterpolate(class, doc.Anchors)
+}
+
+func foreverInterpolate(class proto.Class, anchors []foreverAnchor) {
+	type point struct {
+		level  int32
+		values []float64
+	}
+	top := ClassBaseStats[class]
+	points := []point{}
+	for _, a := range anchors {
+		if a.Level >= 60 {
+			continue
+		}
+		offset := RaceOffsets[proto.Race(proto.Race_value[a.Race])]
+		values := a.values()
+		for i, s := range foreverAttributes {
+			values[i] -= offset[s]
+		}
+		points = append(points, point{a.Level, values})
+	}
+	last := make([]float64, len(foreverAttributes))
+	for i, s := range foreverAttributes {
+		last[i] = top[s]
+	}
+	points = append(points, point{60, last})
+	sort.SliceStable(points, func(i, j int) bool { return points[i].level < points[j].level })
+	level := CharacterLevel
+	if level >= 60 || points[0].level > level {
+		return
+	}
+	lo, hi := points[0], points[len(points)-1]
+	for _, p := range points {
+		if p.level <= level {
+			lo = p
+		}
+		if p.level >= level && p.level < hi.level {
+			hi = p
+		}
+	}
+	for i, s := range foreverAttributes {
+		value := lo.values[i]
+		if hi.level > lo.level {
+			value += (hi.values[i] - lo.values[i]) * float64(level-lo.level) / float64(hi.level-lo.level)
+		}
+		top[s] = value
+	}
+	ClassBaseStats[class] = top
+}
